# Variables SERVEUR — elles vivent dans Vercel (Preview + Production).
# Jamais de préfixe VITE_ : ce qui porte VITE_ finit dans le bundle.
# Ce fichier est un modèle : le vrai .env n'est jamais commité.

# Clé-valeur (Upstash Redis via Vercel Marketplace).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signature des jetons de session — 32 octets aléatoires.
#   openssl rand -base64 32
SESSION_SECRET=

# Envoi transactionnel (Resend).
RESEND_API_KEY=
# Expéditeur. Sans domaine vérifié, Resend n'accepte que onboarding@resend.dev.
MAIL_FROM="Atelier Boris <onboarding@resend.dev>"

# --- Local uniquement, jamais dans Vercel ---
# Clé Anthropic de test, utilisée par la vérification de bout en bout.
# En production, chaque visiteur colle la sienne dans son navigateur.
ANTHROPIC_TEST_KEY=
